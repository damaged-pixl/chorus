<?xml version="1.0" encoding="utf-8"?>
<!--
  Row for one track: 52dp rounded art, bold title, muted "artist • album • year"
  (only the parts that exist), tabular duration pinned to the right.

  NOTE: QueuePanel inflates this same layout and reads @id/art, @id/title,
  @id/subtitle and @id/duration — keep those four ids and their view types.
  The artwork background/outline is applied in TrackAdapter (rounded shape +
  clipToOutline) so no drawable resource is needed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:minWidth="42dp"
        android:gravity="end"
        android:textSize="13sp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
