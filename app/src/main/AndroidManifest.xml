<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local audio only. No INTERNET permission: the app cannot phone home even
         if it wanted to. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Share-to-Chorus on API 26–28 only: writing into shared Music needs it there.
         API 29+ contributes through the MediaStore insert with no permission at all,
         and the manifest cap keeps it off every modern install. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- "Restore queue after reboot": a normal permission the user never sees asked for,
         and only ever acted on when the matching setting is on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Media3 declares this transitively for streaming. We only ever play local
         files, so remove it — nothing here touches the network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chorus">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="false" />

        <!-- "Share to Chorus": audio files another app already holds (browser download,
             messenger attachment, file manager) offered into the library. audio/* only —
             Chorus is audio players, not video — and application/octet-stream too,
             because download managers routinely mislabel their audio. The window is
             translucent (Theme.Chorus.Translucent): only the choice dialog appears,
             over whatever app shared. No INTERNET permission backs this: the bytes come
             from the sending app's Uri, never from a network this app cannot reach. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Chorus.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Home-screen mini player. Not exported: the launcher's widget host reaches it
             through the system, and its transport buttons are explicit intents to itself.
             Updates are pushed from PlaybackService's player listener, never polled. -->
        <receiver
            android:name=".widget.ChorusWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_info" />
        </receiver>

        <!-- "Restore queue after reboot", opt-in. Not exported: BOOT_COMPLETED is a system
             broadcast and a non-exported receiver still receives those, so only the system
             (and this app) can ever reach it. -->
        <receiver
            android:name=".playback.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>