<?xml version="1.0" encoding="utf-8"?>
<!--
  The surface every dialog in the app sits on: the app's own surface colour, a hairline
  border in the divider ink and a 16dp corner radius, so a menu looks like a card from the
  app rather than a stock system dialog.

  The colours are theme attributes, so the same drawable serves the normal, the dark and
  the cycle themes — the dialog's own theme decides which palette is in force.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/chorusSurfaceElevated" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/chorusDivider" />
</shape>
