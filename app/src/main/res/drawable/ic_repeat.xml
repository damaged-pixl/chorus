<?xml version="1.0" encoding="utf-8"?>
<!--
  Repeat all: a loop that runs right along the top, turns down and comes back along the
  bottom, with an arrowhead at each end.

  The loop fills the frame deliberately. The first version drew it small and high in the
  24x24 box, so next to the shuffle icon it read as squished rather than as the same
  kind of mark. The loop now spans the frame the way the shuffle icon does, and sits on
  its centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M5,7 H19"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16,3.6 L20.6,7 L16,10.4 Z" />
    <path
        android:fillColor="#00000000"
        android:pathData="M19,7 v5 a4,4 0 0 1 -4,4 H5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,12 L4.4,16 L9,19.6 Z" />
</vector>
