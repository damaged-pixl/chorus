<?xml version="1.0" encoding="utf-8"?>
<!--
  One accent-coloured bar shape, used as the selected tab's underline and as the now-playing
  cue on a track row. Square ends so it reads as an edge, not a pill. A shape drawable, not
  an image asset.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_accent" />
</shape>