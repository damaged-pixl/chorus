<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget card: rounded near-black, like the media notification.

     Colours are fixed @color values, not ?attr/ tokens: RemoteViews is inflated by the
     launcher with no Chorus theme in scope. See the widget block in values/colors.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chorus_widget_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/chorus_widget_divider" />
    <corners android:radius="18dp" />
</shape>
