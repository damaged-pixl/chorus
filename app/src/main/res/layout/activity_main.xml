<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tab strip: one weighted slot per tab, each holding the tab button (the ids
         MainActivity wires up) plus an accent underline that only the selected tab shows.
         Still a plain LinearLayout, not a ScrollView — a ScrollView here collapsed the
         strip and let the list overlap it, and the seven labels fit weighted slots easily.
         Each tab's background/text colours are applied in code (Ui.tabBackground), so the
         selected state needs no separate layout. -->
    <LinearLayout
        android:id="@+id/tab_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:background="?android:attr/colorBackground"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/tab_tracks"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:text="Tracks" />

            <View
                android:id="@+id/tab_indicator_tracks"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/tab_albums"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:text="Albums" />

            <View
                android:id="@+id/tab_indicator_albums"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/tab_folders"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:text="Folders" />

            <View
                android:id="@+id/tab_indicator_folders"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/tab_playlists"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:text="Lists" />

            <View
                android:id="@+id/tab_indicator_playlists"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/tab_search"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:text="Search" />

            <View
                android:id="@+id/tab_indicator_search"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/tab_queue"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:text="Queue" />

            <View
                android:id="@+id/tab_indicator_queue"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/tab_settings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:text="Setup" />

            <View
                android:id="@+id/tab_indicator_settings"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Hairline between the strip and the content. Coloured in code so it follows the theme
         instead of being baked into a drawable (see Ui.faintColor). -->
    <View
        android:id="@+id/tab_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:importantForAccessibility="no" />

    <!-- One of: track list, album list, folder browser, playlist list, playlist detail,
         SearchPanel, QueuePanel, settings. Only one is visible at a time. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tracks screen: a slim sort bar (A–Z / Most played / Recently played) above
             the list. The bar is part of the screen, so it is shown/hidden with it. -->
        <LinearLayout
            android:id="@+id/track_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/track_sort_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/sort_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="A–Z"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sort_plays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Most played"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sort_recent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Recently played"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/track_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Albums screen: sort bar over the list, the same shape as the Tracks tab's,
             so the two read as one system. -->
        <LinearLayout
            android:id="@+id/album_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/album_sort_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/album_sort_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="A–Z"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/album_sort_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Artist"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/album_sort_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Year"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/album_sort_added"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Recently added"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/album_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <com.bee.chorus.ui.FolderPanel
            android:id="@+id/folder_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/playlist_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Favourites: a pseudo-playlist over the favourites set, not a row in the
                 playlists table — so it lives outside PlaylistAdapter and cannot be
                 renamed or deleted with a real playlist. -->
            <Button
                android:id="@+id/fav_playlist"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/ic_star_filled"
                android:drawablePadding="10dp"
                android:drawableTint="?android:attr/textColorPrimary"
                android:text="Favourites"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/new_playlist"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="+ New playlist"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/import_playlist"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Import playlist"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/playlist_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

                <!-- One-line empty state, centred over the (empty) playlist list. -->
                <TextView
                    android:id="@+id/playlist_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="32dp"
                    android:paddingTop="40dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="40dp"
                    android:text="No playlists yet — tap ‘+ New playlist’ to make one"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <com.bee.chorus.ui.PlaylistPanel
            android:id="@+id/playlist_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.bee.chorus.ui.SearchPanel
            android:id="@+id/search_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.bee.chorus.ui.QueuePanel
            android:id="@+id/queue_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- The Setup tab: real settings, one row each (see view_settings.xml).
             The wrapper carries the id and the visibility, because an <include>'s own
             android:visibility is not something to rely on. -->
        <FrameLayout
            android:id="@+id/settings_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <include
                layout="@layout/view_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </FrameLayout>

    <!-- Persistent mini player. Clicking it opens the full-screen player. -->
    <com.bee.chorus.ui.MiniPlayer
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>