<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tab strip: plain weighted buttons, no Material TabLayout, no ScrollView
         (a ScrollView here collapsed the strip and let the list overlap it). -->
    <LinearLayout
        android:id="@+id/tab_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <Button
            android:id="@+id/tab_tracks"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:text="Tracks" />

        <Button
            android:id="@+id/tab_albums"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:text="Albums" />

        <Button
            android:id="@+id/tab_playlists"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:text="Lists" />

        <Button
            android:id="@+id/tab_search"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:text="Search" />

        <Button
            android:id="@+id/tab_queue"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:text="Queue" />

        <Button
            android:id="@+id/tab_settings"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:text="Setup" />
    </LinearLayout>

    <!-- One of: track list, album list, playlist list, playlist detail,
         SearchPanel, QueuePanel, settings. Only one is visible at a time. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/track_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/album_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/playlist_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Favourites: a pseudo-playlist over the favourites set, not a row in the
                 playlists table — so it lives outside PlaylistAdapter and cannot be
                 renamed or deleted with a real playlist. -->
            <Button
                android:id="@+id/fav_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="★ Favourites" />

            <Button
                android:id="@+id/new_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="+ New playlist" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlist_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <com.bee.chorus.ui.PlaylistPanel
            android:id="@+id/playlist_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.bee.chorus.ui.SearchPanel
            android:id="@+id/search_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.bee.chorus.ui.QueuePanel
            android:id="@+id/queue_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/settings_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <com.bee.chorus.ui.CycleToggle
                android:id="@+id/cycle_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/settings_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Chorus plays music stored on this phone only. It has no internet permission, no analytics and no ads." />
        </LinearLayout>
    </FrameLayout>

    <!-- Persistent mini player. Clicking it opens the full-screen player. -->
    <com.bee.chorus.ui.MiniPlayer
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>