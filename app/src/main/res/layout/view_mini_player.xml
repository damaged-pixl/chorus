<?xml version="1.0" encoding="utf-8"?>
<!-- Compact mini player: rounded art, title over artist, play/pause on a circular
     ripple, a hairline along the top edge and a 2dp playback-progress hairline just
     below it (width driven by scaleX from MiniPlayer's own playing-and-attached 500 ms
     tick — same discipline as the full player's seek bar; Media3 has no position
     callback).

     The bar's background, the hairline colours, the rounded art and the play/pause disc
     are all applied in code (Ui), so nothing here needs a colour of its own. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/chorusSurfaceElevated"
    android:elevation="8dp">

    <!-- Top edge: a hairline that lifts the bar off the list behind it. Drawn first so
         the progress hairline below stays on top of it. -->
    <View
        android:id="@+id/mini_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/mini_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:contentDescription="Album art"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Nothing playing"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/mini_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▶"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Same amber as the full player's seek fill, so both players read as one system.
         pivotX=0 makes scaleX grow the bar left-to-right; hidden at 0 when idle. -->
    <View
        android:id="@+id/mini_progress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:layout_marginTop="1dp"
        android:background="?attr/chorusAccent"
        android:importantForAccessibility="no"
        android:pivotX="0"
        android:scaleX="0" />
</FrameLayout>
