<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen player. Framework widgets only: no Material, no icon assets, no shipped
     bitmaps, no fonts. Glyphs are literal Unicode.

     Anything that needs a real drawable (rounded corners, gradient scrim, seek-bar track and
     thumb, ripple, mode pills) is built in PlayerPanel.kt from GradientDrawable/RippleDrawable/
     LayerDrawable so this file stays asset-free — a few hundred bytes of code, zero APK bytes.

     Root is a FrameLayout so the artwork-derived backdrop can sit behind the content column.
     The content column is a vertical LinearLayout: no ConstraintLayout dependency.

     Insets: none applied here — PlayerActivity pads the content view itself. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07070A">

    <!-- Backdrop: a 64px decode of the current artwork, stretched to fill. Reads as a soft
         colour wash, costs ~16 KB of RAM. Loaded by Art.load, never a full-size bitmap. -->
    <ImageView
        android:id="@+id/player_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Legibility scrim. Transparent at the top so the backdrop stays visible, opaque at the
         bottom so text and controls read on a bright sleeve. Gradient set in Kotlin. -->
    <View
        android:id="@+id/player_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/player_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Artwork. Height is forced to a square by PlayerPanel.onMeasure so the image is
             never squashed and rarely cropped; rounded corners + drop shadow are applied there
             too (ViewOutlineProvider), which costs no drawable resource. -->
        <FrameLayout
            android:id="@+id/player_art_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/player_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album art"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.015"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:singleLine="true"
            android:text="Nothing playing"
            android:textColor="#FFFFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="#B8FFFFFF"
            android:textSize="15sp" />

        <!-- Track + thumb colours are replaced with a LayerDrawable/ClipDrawable in Kotlin. -->
        <SeekBar
            android:id="@+id/player_seek"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="14dp"
            android:max="0"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:progress="0"
            android:splitTrack="false" />

        <!-- elapsed (left) ... sleep timer (centre) ... total (right). The sleep control
             lives in the time row so the wide modes row keeps its breathing room; it
             shows the countdown ("⏱ 14:32") or "End of track" while armed. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:letterSpacing="0.06"
                android:text="0:00"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/player_sleep"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Sleep timer off, tap to set"
                android:focusable="true"
                android:gravity="center"
                android:text="⏱"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/player_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:letterSpacing="0.06"
                android:text="0:00"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Transport row. TextViews styled as buttons: no icon assets needed.
             60–76 dp targets so it can be hit with a glove, one-handed. -->
        <LinearLayout
            android:id="@+id/player_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_prev"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Previous track"
                android:focusable="true"
                android:gravity="center"
                android:text="⏮"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/player_rewind"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Rewind 10 seconds"
                android:focusable="true"
                android:gravity="center"
                android:text="⏪"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <!-- Filled circle with a dark glyph: the one high-contrast target on the screen. -->
            <TextView
                android:id="@+id/player_play_pause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:contentDescription="Play or pause"
                android:focusable="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="#FF101014"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/player_forward"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Forward 10 seconds"
                android:focusable="true"
                android:gravity="center"
                android:text="⏩"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/player_next"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Next track"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Play modes. Shuffle is on/off; repeat cycles off -> all -> one. Each state has its
             own pill + glyph + colour so it is readable at a glance (see PlayerPanel.renderModes). -->
        <LinearLayout
            android:id="@+id/player_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_shuffle"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Shuffle off"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="🔀"
                android:textColor="#99FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/player_repeat"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Repeat off"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="⇄"
                android:textColor="#99FFFFFF"
                android:textSize="20sp" />

            <!-- Favourite star for the current track. Wrap width (a small glyph), so the
                 row's two 104dp pills plus this still fit a 360dp screen. -->
            <TextView
                android:id="@+id/player_star"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Not a favourite"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="☆"
                android:textColor="#99FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
