<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen player. Framework widgets only: no Material, no icon assets, no shipped
     bitmaps, no fonts. Glyphs are literal Unicode.

     Anything that needs a real drawable (the art card's rounded corners, the backdrop scrim,
     the seek-bar track/buffered/progress layers and thumb, the ripples, the mode pills, the
     scrub preview) is built in PlayerPanel.kt from GradientDrawable/StateListDrawable/
     RippleDrawable/LayerDrawable, so this file stays asset-free — a few hundred bytes of
     code, zero APK bytes.

     Colours are design tokens — ?attr/chorusPlayer* from res/values/attrs.xml, mapped per
     palette in res/values/themes.xml and res/values-night/themes.xml — so the screen follows
     the light, dark and Cycle themes with nothing hard-coded here. The one exception is the
     hairline around the artwork card, which is still drawn in code as a literal (see ART_EDGE
     in PlayerPanel.kt: there is no token for it yet).

     Root is a FrameLayout so the artwork-derived backdrop can sit behind the content column.
     The content column is a vertical LinearLayout: no ConstraintLayout dependency.

     Height budget, which is why the rows are shaped this way: the art card takes whatever is
     left and PlayerPanel.onMeasure squares it, while CycleMode later raises *every*
     clickable target to 72dp. No row may hold more than four controls, or it would need
     360dp and overflow a 360dp screen — so the two 10-second skips flank the scrubber (three
     items in that row), the transport row is the prev / play-pause / next trio, and the four
     mode pills split the width exactly.

     Insets: none applied here — PlayerActivity pads the content view itself. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chorusPlayerBg">

    <!-- Backdrop: a 64px decode of the current artwork, stretched to fill. Reads as a soft
         colour wash behind the card, costs ~16 KB of RAM. Alpha and the legibility scrim are
         set in PlayerPanel.kt; loaded by Art.load, never a full-size bitmap. -->
    <ImageView
        android:id="@+id/player_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Legibility scrim: clear at the top so the wash stays visible, opaque page colour at
         the bottom so title, times and controls read over a bright sleeve. Gradient set in
         Kotlin from the theme's scrim tokens. -->
    <View
        android:id="@+id/player_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/player_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- The hero. A dark mat with rounded corners and a real drop shadow, so the
             artwork is the one thing on the page that reads as a physical object in both
             palettes. Height is forced to a square by PlayerPanel.onMeasure; the mat's
             colour, corners and elevation are applied there too, which costs no drawable
             resource. The token is near-black in the light and Cycle themes (a pale sleeve
             has to read on a pale page) and transparent in the dark one, where the art
             floats over the backdrop instead. -->
        <FrameLayout
            android:id="@+id/player_art_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/player_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album art"
                android:scaleType="centerCrop" />

            <!-- Lyrics sheet: hidden until the user opens it from the toggle in the time
                 row, then drawn over the artwork square. It is a sibling of the art rather
                 than a replacement, so closing it costs no re-decode. -->
            <com.bee.chorus.ui.LyricsPanel
                android:id="@+id/player_lyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Title block: the track name carries the weight, the artist • album line is the
             quiet second. Both take their colour from the theme, so they follow the page.
             No text shadow: over this scrim the two backdrops are a near-opaque light or
             dark page, so a shadow has nothing to fight — the chorusPlayerTextShadow token
             is transparent in light and black-over-black in dark. -->
        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.015"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Nothing playing"
            android:textColor="?attr/chorusPlayerText"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?attr/chorusPlayerTextSecondary"
            android:textSize="15sp" />

        <!-- Scrubber. The two 10-second skips live either side of it rather than in the
             transport row, which keeps every row inside four controls (cycle mode's 72dp).
             The preview pill floats above the bar while a drag is in progress; its x is
             driven from the drag progress in PlayerPanel. -->
        <FrameLayout
            android:id="@+id/player_seek_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_rewind"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Rewind 10 seconds"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⏪"
                    android:textColor="?attr/chorusPlayerTextSecondary"
                    android:textSize="22sp" />

                <SeekBar
                    android:id="@+id/player_seek"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:max="0"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="0"
                    android:splitTrack="false" />

                <TextView
                    android:id="@+id/player_forward"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Forward 10 seconds"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⏩"
                    android:textColor="?attr/chorusPlayerTextSecondary"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Where the drag would land, in the accent colour on a solid pill so it reads
                 over any artwork. Kept laid out at alpha 0 rather than GONE, so its width is
                 known before the first frame of a drag; colour and background come from
                 PlayerPanel. -->
            <TextView
                android:id="@+id/player_seek_preview"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:alpha="0"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="56dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="0:00"
                android:textSize="13sp" />
        </FrameLayout>

        <!-- elapsed (left) ... total (right). The centre slot the sleep control used to
             share is now empty, so the two times sit at the extremes and this row stays
             inside its height budget. There is deliberately no appearance control here:
             light/dark is the system UI mode, and cycle mode lives on the Setup tab only. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:letterSpacing="0.06"
                android:text="0:00"
                android:textColor="?attr/chorusPlayerTextMuted"
                android:textSize="12sp" />

            <!-- Lyrics toggle. A text glyph rather than an icon asset, like every other
                 control here; "≡" reads as lines of text and needs no variation selector. -->
            <TextView
                android:id="@+id/player_lyrics_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:contentDescription="Lyrics hidden, tap to show"
                android:focusable="true"
                android:gravity="center"
                android:text="≡"
                android:textColor="?attr/chorusPlayerTextMuted"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/player_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:letterSpacing="0.06"
                android:text="0:00"
                android:textColor="?attr/chorusPlayerTextMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Transport. The one filled control on the screen is play/pause, in the accent
             with a ripple and a lifted disc; prev/next flank it. -->
        <LinearLayout
            android:id="@+id/player_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_prev"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Previous track"
                android:focusable="true"
                android:gravity="center"
                android:text="⏮"
                android:textColor="?attr/chorusPlayerText"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/player_play_pause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:contentDescription="Play or pause"
                android:focusable="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="?attr/chorusPlayerOnSurface"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/player_next"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Next track"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="?attr/chorusPlayerText"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Play modes, four to a row so cycle mode's 72dp targets still fit (each pill gets
             exactly (360 - 48 - 24) / 4 = 72dp). Each pill is keyed on its mode, so "on" is
             visible at a glance; the star and the sleep timer live here too, the timer showing
             its countdown while armed. -->
        <LinearLayout
            android:id="@+id/player_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_shuffle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Shuffle off, tap to turn on"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="🔀"
                android:textColor="?attr/chorusPlayerTextMuted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/player_repeat"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Repeat off, tap to repeat all"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="⇄"
                android:textColor="?attr/chorusPlayerTextMuted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/player_star"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Not a favourite"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="☆"
                android:textColor="?attr/chorusPlayerTextMuted"
                android:textSize="18sp" />

            <!-- The countdown ("⏱ 14:32") lives in this pill; end-of-track mode reads
                 "⏱ End of track" and ellipsises on a narrow screen, which is why every mode
                 label keeps its content description as the authoritative wording. -->
            <TextView
                android:id="@+id/player_sleep"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Sleep timer off, tap to set"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="⏱"
                android:textColor="?attr/chorusPlayerTextMuted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>