<?xml version="1.0" encoding="utf-8"?>
<!-- Queue panel: Shuffle/Repeat toggles, a "Now playing" summary line, the queue list.
     Buttons are plain framework Button widgets: no Material, no icon assets. Header
     rhythm matches the other panels — control row, quiet status line, then content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/queue_shuffle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="44dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Shuffle"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/queue_repeat"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="44dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Repeat"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/queue_now_playing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Nothing playing"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queue_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <!-- One-line empty state, centred over the (empty) queue list. -->
        <TextView
            android:id="@+id/queue_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="32dp"
            android:paddingTop="40dp"
            android:paddingEnd="32dp"
            android:paddingBottom="40dp"
            android:text="Nothing queued yet — tap a track to start playing"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>