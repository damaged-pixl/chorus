<?xml version="1.0" encoding="utf-8"?>
<!-- Widget provider metadata.

     updatePeriodMillis is 0 on purpose: nothing outside the widget changes while it sits
     there, and every real change (play/pause, track change, queue edits) is pushed from
     PlaybackService's player listener — no polling, no alarm, no battery cost.

     targetCellWidth/Height (API 31+) describe the intended 4x2 home-screen slot; the older
     minWidth/minHeight pair is the same size in the pre-31 formula (70dp x cells - 30dp)
     and doubles as the resize floor. Older releases simply ignore the API 31 attributes,
     hence the tools:targetApi marker. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_player"
    android:minHeight="70dp"
    android:minResizeHeight="70dp"
    android:minResizeWidth="110dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/widget_player"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
